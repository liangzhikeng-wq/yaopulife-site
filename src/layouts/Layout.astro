---
export interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  ogType?: string;
  articleAuthor?: string;
  articleSection?: string;
  productPrice?: string;
}

import CookieBanner from "../components/CookieBanner.astro";

const {
  title,
  description = "Handpicked DIY, AI-Imagined Artistry. Custom handcrafted gifts made to order.",
  ogImage = "/og-image.jpg",
  ogType = "website",
  articleAuthor,
  articleSection,
  productPrice,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const fullOgImage = ogImage.startsWith('http') ? ogImage : `https://yaopulife.com${ogImage}`;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <!-- Google tag (gtag.js) — loaded only with cookie consent -->
  <script>
    window.loadGtag = function() {
      if (window.gtagLoaded) return;
      window.gtagLoaded = true;
      var script = document.createElement('script');
      script.async = true;
      script.src = 'https://www.googletagmanager.com/gtag/js?id=G-44706DBXRP';
      document.head.appendChild(script);
      window.dataLayer = window.dataLayer || [];
      window.gtag = function(){ window.dataLayer.push(arguments); };
      window.gtag('js', new Date());
      window.gtag('config', 'AW-18170525119'); // Google Ads (existing)
      window.gtag('config', 'G-44706DBXRP');   // GA4 traffic analytics
    };
    if (localStorage.getItem('cookie-consent') === 'accepted') {
      window.loadGtag();
    }
  </script>

  <title>{title} | yaopulife DIY</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalURL} />

  <!-- Open Graph -->
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={fullOgImage} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:type" content={ogType} />
  <meta property="og:site_name" content="yaopulife DIY" />
  {ogType === 'article' && articleAuthor && <meta property="article:author" content={articleAuthor} />}
  {ogType === 'article' && articleSection && <meta property="article:section" content={articleSection} />}
  {productPrice && <meta property="product:price:amount" content={productPrice} />}
  {productPrice && <meta property="product:price:currency" content="USD" />}

  <!-- Pinterest -->
  <meta name="p:domain_verify" content="b76db1c1cf08aa2520e87b00538c777a" />
  <meta name="pinterest-rich-pin" content="true" />

  <!-- Google Search Console Verification -->
  <meta name="google-site-verification" content="gA5Bv-t6AGHXEZd_cPzaJ2qjsYBOMsIshqV5xnASEcM" />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={fullOgImage} />

  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />

  <!-- Schema.org -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "yaopulife DIY",
    "url": "https://yaopulife.com",
    "logo": "https://yaopulife.com/logo.png",
    "description": description
  })} />
</head>
<body class="min-h-screen bg-white">
  <slot />
  <slot name="after-footer" />
  <CookieBanner />
</body>
</html>
