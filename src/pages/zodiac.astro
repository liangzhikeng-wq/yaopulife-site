---
const ld = {
  "@context": "https://schema.org",
  "@graph": [
    { "@type": "Organization", "@id": "https://yaopulife.com/#org", "name": "yaopulife", "alternateName": "耀蒲", "url": "https://yaopulife.com", "logo": "https://yaopulife.com/favicon.svg" },
    { "@type": "CollectionPage", "name": "The Chinese Zodiac", "url": "https://yaopulife.com/zodiac", "isPartOf": { "@id": "https://yaopulife.com/#org" } },
    { "@type": "BreadcrumbList", "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://yaopulife.com/" },
      { "@type": "ListItem", "position": 2, "name": "Zodiac", "item": "https://yaopulife.com/zodiac" }
    ] }
  ]
};
import SiteAnalytics from '../components/SiteAnalytics.astro';
import StoryCTA from '../components/StoryCTA.astro';
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>The Chinese Zodiac 十二生肖 — 12 animals, 12 personalities | yaopulife</title>
<meta name="description" content="The 12 animals of the Chinese zodiac, their years and what each one says about you. Hover to reveal the trait.">
<link rel="canonical" href="https://yaopulife.com/zodiac">
<link rel="stylesheet" href="/yaopu.css">
<script type="application/ld+json" set:html={JSON.stringify(ld)} />
</head>
<body>
<nav class="nav"><div class="wrap row">
  <a href="/" class="seal">蒲</a>
  <a href="/" class="brand">yaopulife<small>耀蒲</small></a>
  <span class="links"><a href="/">Home</a><a href="/zodiac" class="on">Zodiac</a><a href="/myths">Myths</a><a href="/festivals">Festivals</a></span>
  <a class="btn" href="/myths">Explore myths →</a>
</div></nav>

<header class="hubhero"><div class="wrap">
  <div class="kicker">Which one are you?</div>
  <h1>The Chinese Zodiac</h1>
  <div class="zh">十 二 生 肖</div>
  <p>Twelve animals, one for each year in a repeating cycle. Find your year below — and hover to see what your sign is said to reveal.</p>
</div></header>

<main class="wrap">
<section id="zodiac" class="sec">
  <div class="grid g6">
    <div class="zcard"><div class="disc">鼠</div><div class="en">Rat</div><div class="yr">2020 · 2032</div></div>
    <div class="zcard"><div class="disc">牛</div><div class="en">Ox</div><div class="yr">2021 · 2033</div></div>
    <div class="zcard"><div class="disc">虎</div><div class="en">Tiger</div><div class="yr">2022 · 2034</div></div>
    <div class="zcard"><div class="disc">兔</div><div class="en">Rabbit</div><div class="yr">2023 · 2035</div></div>
    <div class="zcard"><div class="disc">龙</div><div class="en">Dragon</div><div class="yr">2024 · 2036</div></div>
    <div class="zcard"><div class="disc">蛇</div><div class="en">Snake</div><div class="yr">2025 · 2037</div></div>
    <div class="zcard"><div class="disc">马</div><div class="en">Horse</div><div class="yr">2026 · 2038</div></div>
    <div class="zcard"><div class="disc">羊</div><div class="en">Goat</div><div class="yr">2027 · 2039</div></div>
    <div class="zcard"><div class="disc">猴</div><div class="en">Monkey</div><div class="yr">2028 · 2040</div></div>
    <div class="zcard"><div class="disc">鸡</div><div class="en">Rooster</div><div class="yr">2029 · 2041</div></div>
    <div class="zcard"><div class="disc">狗</div><div class="en">Dog</div><div class="yr">2030 · 2042</div></div>
    <div class="zcard"><div class="disc">猪</div><div class="en">Pig</div><div class="yr">2031 · 2043</div></div>
  </div>
  <div class="callout" style="margin-top:30px;max-width:720px">2026 is the Year of the <b>Horse 马</b> — energy, freedom and the love of the open road. Born in a Horse year? You're in good company.</div>
</section>
</main>

<StoryCTA source="page-zodiac" />
<footer>
  <div class="fine">© 2026 yaopulife · 耀蒲 — Authentic Chinese culture for curious minds.</div>
</footer>
<script is:inline src="/yaopu.js"></script>
<SiteAnalytics />
</body>
</html>
