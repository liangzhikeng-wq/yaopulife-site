      mainImage: "/products/house-portrait/hph-main.jpg",
      gallery: ["/products/house-portrait/hph-scene-shelf.jpg", "/products/house-portrait/hph-scene-gift.jpg", "/products/house-portrait/hph-scene-unboxing.jpg"]
