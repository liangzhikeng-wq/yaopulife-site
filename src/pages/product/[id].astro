      id: "20", title: "Custom Pet Photo Mug", price: "$28", category: "Pet Portraits",
      material: "Ceramic, sublimation print", size: "11oz",
      time: "3-5 days",
      description: "Start every morning with a smile thanks to this custom pet photo mug featuring your beloved companion. High-quality sublimation printing ensures vibrant, fade-resistant colors that last. Perfect for coffee, tea, or as a meaningful gift for pet lovers.",
      mainImage: "/products/custom-pet-mug/cpm-main.jpg",
      gallery: ["/products/custom-pet-mug/cpm-scene-breakfast.jpg", "/products/custom-pet-mug/cpm-scene-hands.jpg"]
    }
  ];
  return products.map(p => ({ params: { id: p.id }, props: p }));
}

const { title, price, category, material, size, time, description, mainImage, gallery } = Astro.props;

// Shared FAQ for the custom-gift buying process. Answers use the store's real
// policies (24h preview, approve-before-production, 7-day returns, 10–20 day turnaround)
// and reference this product's own fields — no fabricated claims.
const faqs = [
  { q: "How does the custom order process work?", a: `Share your photos, ideas, or descriptions and we'll send you a design preview within 24 hours. You approve the design — with free revisions — before we begin. Then our artisans handcraft your ${category.toLowerCase()} and ship it to you.` },
  { q: "How long until I receive my order?", a: `Most pieces are handcrafted and delivered within 10–20 days. This item's typical turnaround is ${time}. Need it sooner? Contact us before ordering and we'll do our best.` },
  { q: "Can I request changes to the design preview?", a: "Yes. We revise the preview until you're happy — production only begins after you approve the design." },
  { q: "What is it made of?", a: `${material}. Each piece is handcrafted by skilled artisans, so slight natural variations make your item one of a kind.` },
  { q: "Will the final handmade piece match the preview?", a: "The preview shows the design direction. Your final piece is handcrafted by an artisan to match it as closely as possible — it's handmade, not mass-produced." },
  { q: "What if I'm not happy with my order?", a: "If something isn't right, contact us within 7 days of delivery and we'll arrange a replacement or refund." },
];
---

<Layout title={title} description={description} ogImage={mainImage} ogType="product" productPrice={price.replace('$', '')}>
  <Navbar />

  <!-- Schema.org Product Structured Data -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Product",
    "name": title,
    "description": description,
    "image": [`https://yaopulife.com${mainImage}`, ...gallery.map(g => `https://yaopulife.com${g}`)],
    "brand": { "@type": "Brand", "name": "yaopulife DIY" },
    "category": category,
    "material": material,
    "offers": {
      "@type": "Offer",
      "url": `https://yaopulife.com/product/${Astro.params.id}`,
      "priceCurrency": "USD",
      "price": price.replace(/[^0-9.]/g, ''),
      "availability": "https://schema.org/InStock",
      "itemCondition": "https://schema.org/NewCondition",
      "seller": { "@type": "Organization", "name": "yaopulife DIY" }
    }
  })} />

  <!-- Schema.org FAQ Structured Data -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": faqs.map(f => ({
      "@type": "Question",
      "name": f.q,
      "acceptedAnswer": { "@type": "Answer", "text": f.a }
    }))
  })} />

  <section class="py-12 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-2 gap-12">
        <!-- Image Gallery -->
        <div>
          <div class="aspect-square bg-gray-100 rounded-xl overflow-hidden">
            <img src={mainImage} alt={`${title} - Handcrafted ${category} by yaopulife DIY`} class="w-full h-full object-cover" />
          </div>
          <div class="mt-4 grid grid-cols-3 gap-3">
            {gallery.map((img, i) => (
              <div class="aspect-square bg-gray-100 rounded-lg overflow-hidden">
                <img src={img} alt={`${title} - ${['Lifestyle shot', 'Gift presentation', 'Home decor display'][i]}`} class="w-full h-full object-cover hover:scale-105 transition-transform duration-300 cursor-pointer" loading="lazy" />
              </div>
            ))}
          </div>
        </div>

        <!-- Product Info -->
        <div>
          <p class="text-sm text-brand-600 font-medium">{category}</p>
          <h1 class="mt-2 text-3xl font-bold text-gray-900">{title}</h1>
          <p class="mt-4 text-2xl font-semibold text-brand-600">{price}</p>

          <div class="mt-6 prose text-gray-600">
            <p>{description}</p>
          </div>

          <div class="mt-8 space-y-3">
            <div class="flex"><span class="w-24 text-sm font-medium text-gray-500">Material</span><span class="text-sm text-gray-900">{material}</span></div>
            <div class="flex"><span class="w-24 text-sm font-medium text-gray-500">Size</span><span class="text-sm text-gray-900">{size}</span></div>
            <div class="flex"><span class="w-24 text-sm font-medium text-gray-500">Production</span><span class="text-sm text-gray-900">{time}</span></div>
            <div class="flex"><span class="w-24 text-sm font-medium text-gray-500">Delivery</span><span class="text-sm text-gray-900">Shipping: 7–21 business days after production</span></div>
          </div>

          <!-- Satisfaction Guarantee -->
          <div class="mt-6 p-4 bg-green-50 rounded-lg border border-green-100">
            <div class="flex items-start gap-3">
              <svg class="w-6 h-6 text-green-600 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
              </svg>
              <div>
                <p class="text-sm font-medium text-green-800">100% Satisfaction Guaranteed</p>
                <p class="text-xs text-green-600 mt-1">Get a free design preview first. If you're not happy with the final result, we'll make it right or refund your payment.</p>
              </div>
            </div>
          </div>

          <!-- Buy Buttons -->
          <div class="mt-8 space-y-4">
            <p class="text-sm font-medium text-gray-700">Ready to start? Here's how:</p>

            <a href="/contact" class="block w-full text-center px-8 py-4 text-lg font-medium text-white bg-brand-600 rounded-lg hover:bg-brand-700 transition-colors">
              Get Free Design Preview
            </a>
            <p class="mt-2 text-center text-xs text-gray-500">Send your photos & ideas, get a custom design mockup in 24h</p>

            <div class="relative py-4">
              <div class="absolute inset-0 flex items-center">
                <div class="w-full border-t border-gray-200"></div>
              </div>
              <div class="relative flex justify-center text-sm">
                <span class="px-2 bg-white text-gray-500">or pay now with</span>
              </div>
            </div>

            <!-- Payment Options -->
            <div class="space-y-3" id="paymentOptions">
              <label class="flex items-center p-4 border-2 border-brand-500 rounded-lg bg-brand-50 payment-option" data-gateway="paypal">
                <input type="radio" name="payment" value="paypal" class="w-5 h-5 text-brand-600" checked />
                <div class="ml-3 flex-1">
                  <div class="flex items-center justify-between">
                    <span class="font-medium text-gray-900">PayPal</span>
                    <span class="text-xs text-gray-500">3.7% + $0.30</span>
                  </div>
                  <p class="text-xs text-gray-500">PayPal, Credit Card, Bank Transfer</p>
                </div>
              </label>
            </div>

            <button
              id="buyNowBtn"
              data-product-id={Astro.props.id}
              data-product-name={title}
              data-price={price.replace('$', '')}
              class="block w-full text-center px-8 py-4 text-lg font-medium text-white bg-green-600 rounded-lg hover:bg-green-700 transition-colors"
            >
              Pay Now - {price}
            </button>
          </div>

          <!-- Trust Badges -->
          <div class="mt-6 pt-6 border-t border-gray-100">
            <div class="grid grid-cols-2 gap-3">
              <div class="flex items-center gap-2 text-xs text-gray-600">
                <svg class="w-4 h-4 text-green-600 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                <span>Free Design Preview</span>
              </div>
              <div class="flex items-center gap-2 text-xs text-gray-600">
                <svg class="w-4 h-4 text-green-600 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                <span>Handcrafted by Artisans</span>
              </div>
              <div class="flex items-center gap-2 text-xs text-gray-600">
                <svg class="w-4 h-4 text-green-600 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                <span>Worldwide Shipping</span>
              </div>
              <div class="flex items-center gap-2 text-xs text-gray-600">
                <svg class="w-4 h-4 text-green-600 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                <span>Satisfaction Guaranteed</span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Process -->
      <div class="mt-16 border-t pt-12">
        <h2 class="text-2xl font-bold text-gray-900">How Your Custom Piece is Made</h2>
        <div class="mt-8 grid sm:grid-cols-4 gap-6">
          {[
            { step: "1", label: "You Share", desc: "Send photos, ideas, or descriptions" },
            { step: "2", label: "AI Preview", desc: "We create design previews in 24h" },
            { step: "3", label: "Crafting", desc: "Artisans handmake your approved design" },
            { step: "4", label: "Delivery", desc: "Quality checked & shipped worldwide" }
          ].map(s => (
            <div class="text-center">
              <div class="w-10 h-10 mx-auto bg-brand-100 text-brand-600 rounded-full flex items-center justify-center font-bold">{s.step}</div>
              <h3 class="mt-3 font-semibold text-gray-900">{s.label}</h3>
              <p class="mt-1 text-sm text-gray-500">{s.desc}</p>
            </div>
          ))}
        </div>
      </div>

      <!-- Related Articles (Internal Links for SEO) -->
      <div class="mt-16 border-t pt-12">
        <h2 class="text-2xl font-bold text-gray-900">You Might Also Like to Read</h2>
        <div class="mt-6 grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {category === "Pet Portraits" && (
            <>
              <a href="/blog/custom-pet-portrait-guide" class="block p-4 bg-gray-50 rounded-lg hover:bg-brand-50 transition-colors">
                <p class="text-sm font-medium text-brand-600">Gift Guide</p>
                <p class="mt-1 text-sm text-gray-900 font-semibold">Custom Pet Portrait Gift Guide</p>
              </a>
              <a href="/blog/pet-portrait-memorial-guide" class="block p-4 bg-gray-50 rounded-lg hover:bg-brand-50 transition-colors">
                <p class="text-sm font-medium text-brand-600">Memorial Guide</p>
                <p class="mt-1 text-sm text-gray-900 font-semibold">Pet Portrait Memorial Gift Ideas</p>
              </a>
            </>
          )}
          {category === "Custom Gifts" && (
            <>
              <a href="/blog/trending-custom-gift-ideas-2026" class="block p-4 bg-gray-50 rounded-lg hover:bg-brand-50 transition-colors">
                <p class="text-sm font-medium text-brand-600">Gift Guide</p>
                <p class="mt-1 text-sm text-gray-900 font-semibold">Trending Custom Gift Ideas</p>
              </a>
              <a href="/blog/how-to-customize-gifts" class="block p-4 bg-gray-50 rounded-lg hover:bg-brand-50 transition-colors">
                <p class="text-sm font-medium text-brand-600">How It Works</p>
                <p class="mt-1 text-sm text-gray-900 font-semibold">How to Customize Gifts</p>
              </a>
            </>
          )}
          {category === "Home Decor" && (
            <>
              <a href="/blog/personalized-home-decor-trends" class="block p-4 bg-gray-50 rounded-lg hover:bg-brand-50 transition-colors">
                <p class="text-sm font-medium text-brand-600">Home Decor</p>
                <p class="mt-1 text-sm text-gray-900 font-semibold">Personalized Home Decor Trends</p>
              </a>
              <a href="/blog/ocean-themed-home-decor-ideas" class="block p-4 bg-gray-50 rounded-lg hover:bg-brand-50 transition-colors">
                <p class="text-sm font-medium text-brand-600">Inspiration</p>
                <p class="mt-1 text-sm text-gray-900 font-semibold">Ocean Themed Home Decor Ideas</p>
              </a>
            </>
          )}
        </div>
      </div>
    </div>
  </section>

  <Footer />

  <!-- PayPal Payment Script -->
  <script>
    document.getElementById('buyNowBtn')?.addEventListener('click', async function(e) {
      const btn = e.target;
      const productId = btn.dataset.productId;
      const productName = btn.dataset.productName;
      const price = parseFloat(btn.dataset.price);

      try {
        btn.textContent = 'Redirecting to PayPal...';
        btn.disabled = true;

        const response = await fetch('/api/payment-gateway', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            gateway: 'paypal',
            amount: price,
            currency: 'USD',
            productId,
            productName,
            description: 'Handcrafted custom gift from yaopulife'
          })
        });

        const data = await response.json();

        if (data.success && data.url) {
          window.location.href = data.url;
        } else if (data.error && data.config) {
          alert('PayPal not configured. Please add PAYPAL_CLIENT_ID and PAYPAL_CLIENT_SECRET to Vercel environment variables.');
          btn.textContent = 'Pay Now - $' + price;
          btn.disabled = false;
        } else {
          alert('Payment initialization failed. Please try again.');
          btn.textContent = 'Pay Now - $' + price;
          btn.disabled = false;
        }
      } catch (error) {
        console.error('Purchase error:', error);
        alert('Something went wrong. Please try again.');
        btn.textContent = 'Pay Now - $' + price;
        btn.disabled = false;
      }
    });
  </script>

  <!-- FAQ -->
  <section class="py-12 bg-gray-50">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl font-bold text-gray-900 text-center">Frequently Asked Questions</h2>
      <div class="mt-8 space-y-3">
        {faqs.map((f) => (
          <details class="group bg-white rounded-lg border border-gray-200 p-5">
            <summary class="flex justify-between items-center cursor-pointer font-medium text-gray-900 list-none">
              <span>{f.q}</span>
              <span class="ml-4 text-brand-600 group-open:rotate-45 transition-transform">+</span>
            </summary>
            <p class="mt-3 text-gray-600">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>
</Layout>
