---
import fs from "node:fs";
import path from "node:path";
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";

export const prerender = true;

export function getStaticPaths() {
  // 白名单：只发布已通过合规审查的产品。绝不 republish 已退役的测试品。
  const LIVE_SKUS = ["PHONE-CASE-001"];
  const dir = path.join(process.cwd(), "data", "products");
  return LIVE_SKUS.map((sku) => {
    const product = JSON.parse(fs.readFileSync(path.join(dir, `${sku}.json`), "utf-8"));
    return { params: { id: sku.toLowerCase() }, props: { product } };
  });
}

const { product } = Astro.props;
const slug = product.sku.toLowerCase();
const img = (name: string) => `/images/products/${slug}/${name}`;

// faq 字段是 "Question? Answer" 单行，拆成 {q,a}
const faqs = (product.faq || []).map((line: string) => {
  const i = line.indexOf("? ");
  return i >= 0 ? { q: line.slice(0, i + 1), a: line.slice(i + 2) } : { q: line, a: "" };
});

// 询盘 CTA：带产品意向进 contact 表单
const inquireHref = `/contact?interest=${encodeURIComponent("Custom Photo Phone Case")}`;

// 价格展示：规范化两位小数，明确是 base price（运费/税/机型差价在书面报价时确认）
const priceNum = Number(String(product.price).replace(/[^0-9.]/g, ""));
const priceDisplay = isNaN(priceNum) ? product.price : `$${priceNum.toFixed(2)}`;

// 卖点（来自合规返修后的可验证结构，不含绝对性能承诺）
const buildPoints = [
  { t: "Silicone outer + PC support", d: "A flexible silicone feel over a structured shell (final structure confirmed per supplier and phone model)." },
  { t: "Raised screen & camera edges", d: "Keeps the screen and lenses off flat surfaces." },
  { t: "Covered, easy-press buttons", d: "Buttons are covered instead of left as open cutouts." },
  { t: "Reinforced corner design", d: "Extra material at the corners." },
  { t: "Made to order", d: "Your photo, name, or initials — UV-printed or laser-engraved." },
];

// FAQ 结构化数据（SEO）
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};
const productSchema = {
  "@context": "https://schema.org",
  "@type": "Product",
  name: product.title,
  description: product.metaDescription,
  sku: product.sku,
  material: product.material,
  offers: {
    "@type": "Offer",
    price: String(product.price).replace("$", ""),
    priceCurrency: "USD",
    availability: "https://schema.org/MadeToOrder",
    url: `https://yaopulife.com/product/${slug}`,
  },
};
---

<Layout
  title={product.metaTitle}
  description={product.metaDescription}
  ogType="product"
  ogImage={img("main.png")}
  productPrice={String(product.price).replace("$", "")}
>
  <Navbar />

  <main class="bg-white">
    <!-- Breadcrumb -->
    <nav class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-6 text-sm text-gray-500">
      <a href="/" class="hover:text-brand-600">Home</a>
      <span class="mx-2">/</span>
      <a href="/shop" class="hover:text-brand-600">Shop</a>
      <span class="mx-2">/</span>
      <span class="text-gray-700">Custom Photo Phone Case</span>
    </nav>

    <!-- Hero -->
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 grid lg:grid-cols-2 gap-12">
      <!-- Gallery -->
      <div>
        <div class="gallery-main relative rounded-2xl overflow-hidden bg-gray-50 border border-gray-100 aspect-square">
          <img src={img("main.png")} alt={product.altTags?.[0] || product.title}
               class="w-full h-full object-cover" loading="eager"
               onerror="this.closest('.gallery-main').classList.add('img-fallback')" />
          <div class="fallback-note hidden absolute inset-0 flex-col items-center justify-center text-center p-8 text-gray-400">
            <span class="text-sm font-medium">Product preview image</span>
          </div>
          <span class="absolute bottom-3 left-3 rounded-md bg-black/60 px-2 py-1 text-[11px] font-medium text-white">
            Digital render — design preview only, not a production photo
          </span>
        </div>
        <div class="mt-4 grid grid-cols-3 gap-3">
          {["scene.png", "detail.png", "main.png"].map((n, i) => (
            <div class="rounded-xl overflow-hidden bg-gray-50 border border-gray-100 aspect-square">
              <img src={img(n)} alt={product.altTags?.[i] || product.title} class="w-full h-full object-cover" loading="lazy"
                   onerror="this.style.display='none'" />
            </div>
          ))}
        </div>
        <p class="mt-3 text-xs text-gray-500">All product images are digital renders for design preview only — not production photos. Final color, texture, and print placement may vary by phone model and approved artwork.</p>
      </div>

      <!-- Info -->
      <div>
        <p class="text-sm font-semibold uppercase tracking-wide text-brand-600">Custom Gifts · Made to order</p>
        <h1 class="mt-2 text-3xl sm:text-4xl font-bold text-gray-900 leading-tight">{product.title}</h1>
        <div class="mt-4 flex items-baseline gap-3">
          <span class="text-3xl font-bold text-gray-900">{priceDisplay}</span>
          <span class="text-sm text-gray-500">base price · personalization included</span>
        </div>
        <p class="mt-1 text-sm text-gray-500">Shipping, taxes, and any phone-model-specific changes are confirmed in your written quote before payment.</p>
        <p class="mt-5 text-lg text-gray-600 leading-relaxed">{product.shortDescription}</p>

        <ul class="mt-6 space-y-2">
          {buildPoints.map((p) => (
            <li class="flex gap-3 text-gray-700">
              <svg class="mt-1 h-5 w-5 flex-shrink-0 text-brand-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
              <span><strong class="font-semibold text-gray-900">{p.t}</strong> — {p.d}</span>
            </li>
          ))}
        </ul>

        <div class="mt-8 flex flex-col sm:flex-row gap-3">
          <a href={inquireHref} class="inline-flex items-center justify-center px-7 py-3.5 text-base font-semibold text-white bg-brand-600 rounded-lg hover:bg-brand-700 transition-colors">
            Request This Case
          </a>
          <a href={inquireHref} class="inline-flex items-center justify-center px-7 py-3.5 text-base font-semibold text-brand-700 bg-brand-50 rounded-lg hover:bg-brand-100 transition-colors">
            Ask a Question
          </a>
        </div>
        <p class="mt-3 text-sm text-gray-500">
          Made to order. Production: {product.productionTime}. Estimated delivery varies by destination after shipment.
        </p>
      </div>
    </section>

    <!-- How it works -->
    <section class="bg-gray-50 border-y border-gray-100">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14">
        <h2 class="text-2xl font-bold text-gray-900 text-center">How It Works</h2>
        <div class="mt-10 grid sm:grid-cols-3 gap-6">
          {[
            { n: "1", t: "Pick your phone model", d: "Tell us your iPhone or Samsung model in the request." },
            { n: "2", t: "Share your design", d: "Upload a photo or send your name / initials and approve the proof." },
            { n: "3", t: "We make it to order", d: `Production ${product.productionTime}. We confirm everything before anything is made.` },
          ].map((s) => (
            <div class="rounded-2xl bg-white border border-gray-100 p-7">
              <div class="h-10 w-10 rounded-full bg-brand-600 text-white flex items-center justify-center font-bold">{s.n}</div>
              <h3 class="mt-4 text-lg font-semibold text-gray-900">{s.t}</h3>
              <p class="mt-2 text-gray-600">{s.d}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Specifications -->
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14 grid lg:grid-cols-2 gap-12">
      <div>
        <h2 class="text-2xl font-bold text-gray-900">Specifications</h2>
        <dl class="mt-6 divide-y divide-gray-100 border-t border-gray-100">
          {[
            ["Material", product.material],
            ["Fits", product.size],
            ["Customization", "Photo, name, initials, or monogram (UV print / laser engraving)"],
            ["Production time", product.productionTime],
            ["Price", `${priceDisplay} base price — personalization included; shipping, taxes, and model-specific changes confirmed in your quote before payment`],
          ].map(([k, v]) => (
            <div class="py-3 grid grid-cols-3 gap-4">
              <dt class="text-sm font-medium text-gray-500">{k}</dt>
              <dd class="col-span-2 text-sm text-gray-800">{v}</dd>
            </div>
          ))}
        </dl>
      </div>

      <div>
        <h2 class="text-2xl font-bold text-gray-900">Returns</h2>
        <div class="mt-6 rounded-2xl bg-brand-50 border border-brand-100 p-6 text-gray-700 leading-relaxed">
          <p><strong>Covered:</strong> replacement or refund for defects, production errors, or items materially different from the proof you approved — verified by photos of the item you received.</p>
          <p class="mt-3"><strong>Not covered:</strong> customer-entry mistakes (wrong text, low-resolution photo), change of mind, or normal variation already disclosed on this page.</p>
          <p class="mt-3 text-sm text-gray-500">
            The exact claim window, the photo evidence we ask for, and who pays return shipping are stated in the written quote or invoice you approve before any payment or production. This site has no automated checkout.
          </p>
        </div>
        <div class="mt-4 rounded-xl border border-gray-100 p-4 text-sm text-gray-500">
          <strong class="text-gray-700">A note on images:</strong> product images are digital renders for design
          preview only — not production photos. Final color, texture, camera cutout, and print placement may vary by
          phone model and approved artwork.
        </div>
      </div>
    </section>

    <!-- FAQ -->
    {faqs.length > 0 && (
      <section class="bg-gray-50 border-t border-gray-100">
        <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-14">
          <h2 class="text-2xl font-bold text-gray-900 text-center">Frequently Asked Questions</h2>
          <div class="mt-8 space-y-3">
            {faqs.map((f) => (
              <details class="group rounded-xl bg-white border border-gray-100 p-5">
                <summary class="cursor-pointer list-none flex justify-between items-center font-semibold text-gray-900">
                  {f.q}
                  <svg class="h-5 w-5 text-gray-400 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
                </summary>
                <p class="mt-3 text-gray-600 leading-relaxed">{f.a}</p>
              </details>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- Bottom CTA -->
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 text-center">
      <h2 class="text-3xl font-bold text-gray-900">Request a personalized case, made to your design</h2>
      <p class="mt-3 text-lg text-gray-600">Send your photo or text and phone model — we reply on business days with a proof and a written quote before anything is made.</p>
      <a href={inquireHref} class="mt-7 inline-flex items-center justify-center px-8 py-4 text-base font-semibold text-white bg-brand-600 rounded-lg hover:bg-brand-700 transition-colors">
        Request This Case
      </a>
    </section>
  </main>

  <Footer />

  <script type="application/ld+json" set:html={JSON.stringify(productSchema)} />
  {faqs.length > 0 && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}

  <style>
    .img-fallback img { display: none; }
    .img-fallback .fallback-note { display: flex; }
  </style>
</Layout>
