---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
---

<Layout title="About yaopulife" description="yaopulife makes custom, made-to-order phone cases personalized with your photo, name, or initials — with a preview-first, no-surprises process.">
  <Navbar />

  <section class="py-20 bg-white">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="text-4xl font-bold text-gray-900">Our Story</h1>

      <div class="mt-8 prose prose-lg text-gray-600">
        <p class="text-xl leading-relaxed">
          yaopulife makes one thing well: custom phone cases built around the photo or text that matters to you.
          A favorite photo, a name, your initials — made to order on a slim, protective case.
        </p>

        <p>
          We work preview-first. You send your design and phone model, we send back a proof and a written quote,
          and only after you approve it do we make your case. There is no automated checkout and no surprise
          charges — price, shipping, and timing are confirmed in writing before any payment.
        </p>

        <h2 class="text-2xl font-bold text-gray-900 mt-12">What Makes Us Different</h2>

        <ul class="mt-4 space-y-3">
          <li><strong>Truly made to order:</strong> Each case is produced after you approve a proof — nothing is mass-printed in advance.</li>
          <li><strong>Preview-first:</strong> You see a proof and a written quote before anything is produced or paid.</li>
          <li><strong>Honest images:</strong> Product images are digital renders for design preview, not production photos — and we say so.</li>
          <li><strong>Clear structure, no hype:</strong> We describe the case build (silicone outer, PC support, raised edges) without exaggerated protection claims.</li>
        </ul>

        <h2 class="text-2xl font-bold text-gray-900 mt-12">Our Promise</h2>

        <p>
          Personalized products should be made with care and described honestly. Our promise is to keep the process
          transparent, avoid exaggerated claims, and confirm every detail with you before your case is made.
        </p>
      </div>

      <div class="mt-10">
        <a href="/shop" class="inline-flex items-center px-6 py-3 text-base font-semibold text-white bg-brand-600 rounded-lg hover:bg-brand-700 transition-colors">
          Shop custom cases
        </a>
      </div>
    </div>
  </section>

  <Footer />
</Layout>
