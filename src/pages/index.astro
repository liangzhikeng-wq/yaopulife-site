    <a class="zcard" href="/zodiac"><div class="disc">狗</div><div class="en">Dog</div><div class="yr">2030 · 2042</div></a>
    <a class="zcard" href="/zodiac"><div class="disc">猪</div><div class="en">Pig</div><div class="yr">2031 · 2043</div></a>
  </div>
</section>

<section class="sec" id="festivals">
  <div class="sec-h"><h2>Festivals</h2><span class="han">传统节日</span><a class="more" href="/festivals">all festivals →</a></div>
  <div class="grid g3">
    <a class="card" href="/changge"><div class="top"><div class="moonbg"></div><span>中秋</span></div><div class="bd"><div class="tag">Autumn</div><h3>Mid-Autumn Festival<span class="ready">Ready</span></h3><p>Mooncakes, lanterns and the full-moon reunion — with the Chang'e legend at its heart.</p><div class="rd">Explore →</div></div></a>
    <a class="card" href="/festivals"><div class="top"><span>春节</span></div><div class="bd"><div class="tag">Winter</div><h3>Lunar New Year<span class="soon">Coming soon</span></h3><p>Red envelopes, the Nian beast, and the world's largest celebration.</p><div class="rd">See all festivals →</div></div></a>
    <a class="card" href="/festivals"><div class="top"><span>端午</span></div><div class="bd"><div class="tag">Summer</div><h3>Dragon Boat Festival<span class="soon">Coming soon</span></h3><p>Dragon boats, rice dumplings, and the poet who gave his life to the river.</p><div class="rd">See all festivals →</div></div></a>
  </div>
