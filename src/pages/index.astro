const ld = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": "https://yaopulife.com/#org",
      "name": "yaopulife",
      "alternateName": "耀蒲",
      "url": "https://yaopulife.com",
      "logo": "https://yaopulife.com/favicon.svg",
      "description": "Authentic Chinese myths, festivals and culture — told by a native, for curious minds everywhere."
    },
    {
      "@type": "WebSite",
      "@id": "https://yaopulife.com/#site",
      "url": "https://yaopulife.com",
      "name": "yaopulife",
