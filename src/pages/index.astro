    <a class="zcard" href="/zodiac"><div class="disc">鼠</div><div class="en">Rat</div><div class="yr">2020 · 2032</div></a>
    <a class="zcard" href="/zodiac"><div class="disc">牛</div><div class="en">Ox</div><div class="yr">2021 · 2033</div></a>
    <a class="zcard" href="/zodiac"><div class="disc">虎</div><div class="en">Tiger</div><div class="yr">2022 · 2034</div></a>
    <a class="zcard" href="/zodiac"><div class="disc">兔</div><div class="en">Rabbit</div><div class="yr">2023 · 2035</div></a>
    <a class="zcard" href="/zodiac"><div class="disc">龙</div><div class="en">Dragon</div><div class="yr">2024 · 2036</div></a>
    <a class="zcard" href="/zodiac"><div class="disc">蛇</div><div class="en">Snake</div><div class="yr">2025 · 2037</div></a>
    <a class="zcard" href="/zodiac"><div class="disc">马</div><div class="en">Horse</div><div class="yr">2026 · 2038</div></a>
    <a class="zcard" href="/zodiac"><div class="disc">羊</div><div class="en">Goat</div><div class="yr">2027 · 2039</div></a>
