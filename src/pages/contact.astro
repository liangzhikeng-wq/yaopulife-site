---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";

export const prerender = true;
---

<Layout title="Contact yaopulife" description="Questions, collaborations, licensing or custom culture packs — get in touch with yaopulife. We reply on business days.">
  <Navbar />

  <section class="py-20 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center">
        <h1 class="text-4xl font-bold text-gray-900">Get in touch</h1>
        <p class="mt-4 text-lg text-gray-600">Story suggestions, collaborations, licensing, or a custom culture pack for your classroom or brand — tell us what you have in mind. We reply on business days.</p>
      </div>

      <div class="mt-12 grid md:grid-cols-2 gap-12">
        <div>
          <h2 class="text-xl font-semibold text-gray-900">Send a Message</h2>
          <form id="contactForm" class="mt-6 space-y-4">
            <div class="grid md:grid-cols-2 gap-4">
              <div>
                <label for="name" class="block text-sm font-medium text-gray-700">Name <span class="text-red-500">*</span></label>
                <input type="text" id="name" name="name" required placeholder="Your full name" class="mt-1 block w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-brand-500 focus:border-brand-500" />
              </div>
              <div>
                <label for="email" class="block text-sm font-medium text-gray-700">Email <span class="text-red-500">*</span></label>
                <input type="email" id="email" name="email" required placeholder="your@email.com" class="mt-1 block w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-brand-500 focus:border-brand-500" />
              </div>
            </div>
            <div>
              <label for="interest" class="block text-sm font-medium text-gray-700">What's it about? <span class="text-red-500">*</span></label>
              <select id="interest" name="interest" required class="mt-1 block w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-brand-500 focus:border-brand-500">
                <option value="">Select an option...</option>
                <option>Content collaboration / partnership</option>
                <option>Licensing &amp; education use</option>
                <option>Custom culture pack (classroom / brand)</option>
                <option>Press &amp; media</option>
                <option>Story suggestion / feedback</option>
                <option>Other</option>
              </select>
            </div>
            <div class="grid md:grid-cols-2 gap-4">
              <div>
                <label for="budget" class="block text-sm font-medium text-gray-700">Budget Range</label>
                <select id="budget" name="budget" class="mt-1 block w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-brand-500 focus:border-brand-500">
                  <option>Not sure yet</option>
                  <option>Under $50</option>
                  <option>$50 - $100</option>
                  <option>$100 - $200</option>
                  <option>$200+</option>
                </select>
              </div>
              <div>
                <label for="timeline" class="block text-sm font-medium text-gray-700">Needed By</label>
                <select id="timeline" name="timeline" class="mt-1 block w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-brand-500 focus:border-brand-500">
                  <option>No specific deadline</option>
                  <option>1-2 weeks</option>
                  <option>3-4 weeks</option>
                  <option>1-2 months</option>
                  <option>Special date (please specify below)</option>
                </select>
              </div>
            </div>
            <div>
              <label for="message" class="block text-sm font-medium text-gray-700">Your message <span class="text-red-500">*</span></label>
              <textarea id="message" name="message" rows="4" required placeholder="Tell us what you have in mind — the project, the audience, and anything we should know." class="mt-1 block w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-brand-500 focus:border-brand-500"></textarea>
            </div>
            <div class="flex items-start">
              <input type="checkbox" id="privacy" name="privacy" required class="mt-1 h-4 w-4 text-brand-600 border-gray-300 rounded" />
              <label for="privacy" class="ml-2 text-sm text-gray-600">I agree to the <a href="/privacy" class="text-brand-600 hover:underline">Privacy Policy</a></label>
            </div>
            <button type="submit" id="submitBtn" class="w-full px-6 py-3 text-base font-medium text-white bg-brand-600 rounded-lg hover:bg-brand-700 transition-colors">
              Send message
            </button>
          </form>

          <div id="formSuccess" class="hidden mt-6 p-4 bg-green-50 border border-green-200 rounded-lg">
            <div class="flex">
              <div class="flex-shrink-0">
                <svg class="h-5 w-5 text-green-400" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                </svg>
              </div>
              <div class="ml-3">
                <p class="text-sm font-medium text-green-800">Message sent successfully!</p>
                <p class="text-sm text-green-600 mt-1">We'll review the request and reply on business days.</p>
              </div>
            </div>
          </div>

          <div id="formError" class="hidden mt-6 p-4 bg-red-50 border border-red-200 rounded-lg">
            <div class="flex">
              <div class="flex-shrink-0">
                <svg class="h-5 w-5 text-red-400" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"/>
                </svg>
              </div>
              <div class="ml-3">
                <p class="text-sm font-medium text-red-800">Failed to send message</p>
                <p class="text-sm text-red-600 mt-1">Please try again or email us directly.</p>
              </div>
            </div>
          </div>
        </div>

        <div>
          <h2 class="text-xl font-semibold text-gray-900">Other Ways to Reach Us</h2>
          <div class="mt-6 space-y-4">
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 bg-brand-100 rounded-lg flex items-center justify-center">
                <svg class="w-5 h-5 text-brand-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
              </div>
              <div>
                <p class="text-sm font-medium text-gray-900">Email</p>
                <p class="text-sm text-gray-600">hello@yaopulife.com</p>
              </div>
            </div>
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 bg-brand-100 rounded-lg flex items-center justify-center">
                <svg class="w-5 h-5 text-brand-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
              </div>
              <div>
                <p class="text-sm font-medium text-gray-900">Response time</p>
                <p class="text-sm text-gray-600">We reply on business days</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <Footer />

  <script>
    // 从 URL ?interest=... 预选产品意向（产品页询盘 CTA 带过来）
    (function preselectInterest() {
      const wanted = new URLSearchParams(window.location.search).get('interest');
      if (!wanted) return;
      const sel = document.getElementById('interest');
      if (!sel) return;
      const match = Array.from(sel.options).find(o => o.value === wanted || o.text === wanted);
      if (match) sel.value = match.value || match.text;
    })();

    document.getElementById('contactForm')?.addEventListener('submit', async function(e) {
      e.preventDefault();

      const form = e.target;
      const submitBtn = document.getElementById('submitBtn');
      const formSuccess = document.getElementById('formSuccess');
      const formError = document.getElementById('formError');

      const formData = {
        name: form.name.value,
        email: form.email.value,
        interest: form.interest.value,
        budget: form.budget.value,
        timeline: form.timeline.value,
        message: form.message.value,
        privacy: form.privacy.checked
      };

      try {
        submitBtn.textContent = 'Sending...';
        submitBtn.disabled = true;
        formError.classList.add('hidden');

        const response = await fetch('/api/contact', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(formData)
        });

        const data = await response.json();

        if (data.success) {
          form.classList.add('hidden');
          formSuccess.classList.remove('hidden');
          if (window.gtag) window.gtag('event', 'generate_lead', { form: 'contact' });
        } else {
          throw new Error(data.error || 'Failed to send message');
        }
      } catch (error) {
        console.error('Form error:', error);
        formError.classList.remove('hidden');
        submitBtn.textContent = 'Send message';
        submitBtn.disabled = false;
      }
    });
  </script>
</Layout>
