---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";

const steps = [
  { num: "01", title: "Pick your phone model", desc: "Tell us your iPhone or Samsung model so the case is made to fit." },
  { num: "02", title: "Share your design", desc: "Upload a photo, or send a name, initials, or monogram, and any placement notes." },
  { num: "03", title: "Get a proof and quote", desc: "We send back a design proof and a written quote — final price, shipping, taxes, and production timing, confirmed before payment." },
  { num: "04", title: "Approve and pay", desc: "Once you approve the proof and quote, payment is arranged directly. There is no automated checkout on the site." },
  { num: "05", title: "Made and shipped", desc: "Your case is produced to order and shipped. Production is typically 7–12 business days." },
];

const faqs = [
  { q: "How do I order?", a: "Send your phone model, photo or text, and any notes through the product page or contact form. We reply with a proof and a written quote before anything is made or paid." },
  { q: "Is there a checkout button?", a: "No. This site has no automated checkout. Each case is quoted and confirmed in writing first, then payment is arranged directly." },
  { q: "What can I customize?", a: "Your photo, name, initials, or monogram — UV-printed or laser-engraved on the case." },
  { q: "How long does production take?", a: "Production is typically 7–12 business days after you approve the proof. Delivery time depends on your destination after shipment." },
  { q: "Are the product images real photos?", a: "No — they are digital renders for design preview only. Final color, texture, and print placement may vary by phone model and approved artwork." },
  { q: "What's your return policy?", a: "Made-to-order cases are eligible for replacement or refund for defects, production errors, or items materially different from your approved proof. Customer-entry mistakes (wrong text, low-resolution photo) and change of mind are not covered. The exact claim window and evidence are stated in your written quote." },
  { q: "Do you ship internationally?", a: "Yes. Shipping coverage, cost, and timing are confirmed in your written quote before payment." },
];
---

<Layout title="How It Works" description="How yaopulife makes your custom phone case: pick your model, share your design, approve a proof and written quote, then we make it to order.">
  <Navbar />

  <section class="py-20 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="text-4xl font-bold text-center text-gray-900">How It Works</h1>
      <p class="mt-4 text-lg text-center text-gray-600">From your photo to a finished case — proof and quote first, no surprises.</p>

      <div class="mt-16 space-y-12">
        {steps.map((step) => (
          <div class="flex gap-6">
            <div class="flex-shrink-0 w-14 h-14 bg-brand-600 text-white rounded-full flex items-center justify-center text-lg font-bold">
              {step.num}
            </div>
            <div>
              <h3 class="text-xl font-semibold text-gray-900">{step.title}</h3>
              <p class="mt-2 text-gray-600">{step.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-20 bg-gray-50">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold text-center text-gray-900">Frequently Asked Questions</h2>
      <div class="mt-12 space-y-4">
        {faqs.map(faq => (
          <details class="bg-white rounded-lg shadow-sm">
            <summary class="px-6 py-4 text-lg font-medium text-gray-900 cursor-pointer hover:bg-gray-50 rounded-lg">
              {faq.q}
            </summary>
            <div class="px-6 pb-4 text-gray-600">{faq.a}</div>
          </details>
        ))}
      </div>
      <div class="mt-12 text-center">
        <a href="/shop" class="inline-flex items-center px-6 py-3 text-base font-semibold text-white bg-brand-600 rounded-lg hover:bg-brand-700 transition-colors">
          Shop custom cases
        </a>
      </div>
    </div>
  </section>

  <Footer />
</Layout>
