---

<footer class="bg-gray-900 text-gray-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-8">
      <div class="col-span-2 md:col-span-1">
        <a href="/" class="text-2xl font-bold text-white">yaopulife</a>
        <p class="mt-4 text-sm text-gray-400">Handpicked DIY, AI-Imagined Artistry.</p>

        <!-- Trust Badges -->
        <div class="mt-6 flex flex-wrap gap-4">
          <div class="flex items-center gap-2 text-xs text-gray-400">
            <svg class="w-5 h-5 text-green-500" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M2.166 4.999A11.954 11.954 0 0010 1.944 11.954 11.954 0 0017.834 5c.11.65.166 1.32.166 2.001 0 5.225-3.34 9.67-8 11.317C5.34 16.67 2 12.225 2 7c0-.682.057-1.35.166-2.001zm11.541 3.708a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
            <span>Secure Checkout</span>
          </div>
          <div class="flex items-center gap-2 text-xs text-gray-400">
            <svg class="w-5 h-5 text-green-500" fill="currentColor" viewBox="0 0 20 20"><path d="M8 16.5a1.5 1.5 0 11-3 0 1.5 1.5 0 013 0zM15 16.5a1.5 1.5 0 11-3 0 1.5 1.5 0 013 0z"/><path d="M3 4h1l.6 3h13.8l.6-3h1l-1 5H4l-1-5z"/></svg>
            <span>Worldwide Shipping</span>
          </div>
          <div class="flex items-center gap-2 text-xs text-gray-400">
            <svg class="w-5 h-5 text-green-500" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
            <span>Satisfaction Guaranteed</span>
          </div>
        </div>
      </div>

      {Object.entries(footerLinks).map(([title, links]) => (
        <div>
          <h3 class="text-sm font-semibold text-white uppercase tracking-wider">{title}</h3>
          <ul class="mt-4 space-y-2">
            {links.map(link => (
              <li><a href={link.href} class="text-sm hover:text-white transition-colors">{link.label}</a></li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <div class="mt-12 pt-8 border-t border-gray-800 flex flex-col md:flex-row justify-between items-center">
      <div class="text-sm text-gray-500">
        <p>© 2026 yaopulife DIY. All rights reserved.</p>
        <p class="mt-1 text-xs text-gray-600">Registered in China | hello@yaopulife.com</p>
      </div>
      <div class="mt-4 md:mt-0 flex space-x-5">
        {socialLinks.map(link => (
          <a
            href={link.href}
            target="_blank"
            rel="noopener noreferrer"
            class="text-gray-400 hover:text-white transition-colors"
            aria-label={link.label}
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d={link.icon}/>
            </svg>
          </a>
        ))}
      </div>
    </div>
  </div>
</footer>
